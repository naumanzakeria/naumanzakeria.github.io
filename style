*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#f5f7fa;
    color:#333;
    line-height:1.7;
}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 10%;
    background:#0F172A;
    color:white;
    position:sticky;
    top:0;
    z-index:1000;
}

.logo h2{
    font-size:28px;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:25px;
    font-weight:bold;
    transition:.3s;
}

nav a:hover{
    color:#38BDF8;
}

.hero{
    height:90vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    background:linear-gradient(135deg,#0F172A,#1E3A8A);
    color:white;
    padding:20px;
}

.hero h1{
    font-size:54px;
    max-width:900px;
    margin-bottom:20px;
}

.hero p{
    font-size:22px;
    max-width:750px;
    margin-bottom:40px;
}

.btn{
    display:inline-block;
    background:#38BDF8;
    color:white;
    text-decoration:none;
    padding:15px 35px;
    border-radius:50px;
    font-size:18px;
    transition:.3s;
}

.btn:hover{
    background:#0EA5E9;
    transform:translateY(-3px);
}

section{
    max-width:1100px;
    margin:auto;
    padding:90px 30px;
}

section h2{
    font-size:38px;
    margin-bottom:25px;
    color:#0F172A;
}

section p,
section li{
    font-size:18px;
}

ul{
    margin-left:25px;
}

footer{
    background:#0F172A;
    color:white;
    text-align:center;
    padding:30px;
    margin-top:50px;
}

@media(max-width:768px){

header{
    flex-direction:column;
}

nav{
    margin-top:15px;
}

nav a{
    display:block;
    margin:12px 0;
}

.hero h1{
    font-size:36px;
}

.hero p{
    font-size:18px;
}

}
